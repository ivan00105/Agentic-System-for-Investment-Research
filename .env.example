# Copy this file to .env, then uncomment and fill in only the settings you need.
# .env stays local and must not be committed or shared.
# Tiers: 0 = free, no key; 1 = free with a key; 2 = paid. Anything not set is skipped and shown as
# "not configured" on the Setup & status page, with the variable to set; nothing crashes.

# --- Required ------------------------------------------------------------------------------

# Tier 0. SEC filings, fundamentals and company lookup. SEC requires a name and a real contact email.
# SEC_USER_AGENT="Fieldnote your-email@example.com"

# Model providers. Configure one or multiple providers at the same time (each with its own model
# and key, supporting tool calling), then choose the default or per-agent provider in the web app.

# Tier 2 (OpenRouter pay-per-use; its free models are rate-limited).
# OPENROUTER_API_KEY="your-openrouter-key"
# OPENROUTER_MODEL="provider/model-id"

# Tier 2 (OpenAI).
# OPENAI_API_KEY="your-openai-key"
# OPENAI_MODEL="your-openai-model"

# Tier 0 / 2 (OpenAI-compatible endpoint, e.g. local Ollama or a trusted gateway).
# COMPATIBLE_BASE_URL="https://your-compatible-provider.example/v1"
# COMPATIBLE_MODEL="your-compatible-model"
# COMPATIBLE_API_KEY="your-compatible-key"

# Optional fallback / CLI default selector (openrouter, openai, or compatible) and model override.
# RESEARCH_MODEL_PROVIDER=openrouter
# RESEARCH_MODEL="provider/model-id"
# OPENAI_BASE_URL="https://your-compatible-provider.example/v1"

# Optional. Define extra named model sources (e.g. multiple models on the same provider).
# Each entry needs id, label, provider and model; api_key_env is optional (OPENROUTER_API_KEY,
# OPENAI_API_KEY or COMPATIBLE_API_KEY by provider). Compatible entries use base_url or COMPATIBLE_BASE_URL.
# RESEARCH_MODEL_SOURCES='[{"id":"openrouter-fast","label":"OpenRouter Fast","provider":"openrouter","model":"provider/model-id","api_key_env":"OPENROUTER_API_KEY"},{"id":"openai-main","label":"OpenAI","provider":"openai","model":"gpt-model","api_key_env":"OPENAI_API_KEY"}]'

# --- Optional upgrades ---------------------------------------------------------------------

# Tier 1. Daily prices with as-traded and adjusted closes; goes before yfinance (tier 0, no key)
# when set. Free key: https://www.tiingo.com (50 requests/hour, 1,000/day).
# TIINGO_API_KEY="your-tiingo-key"

# Price provider order, best first (default: tiingo,yfinance). Unconfigured providers are skipped.
# PRICE_PROVIDERS=tiingo,yfinance

# Tier 1. Rates, inflation and unemployment as published on the cutoff day (ALFRED vintages), and the
# release dates of major US data. Without it, Treasury (tier 0, no key) gives the bill rate and yields only.
# The same key gives H.10 exchange rates for converting foreign filers' figures to US dollars (including TWD);
# without it, Frankfurter (ECB rates, tier 0, no key) converts most currencies but not TWD.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY="your-fred-key"

# Macro provider order, best first (default: fred,treasury).
# MACRO_PROVIDERS=fred,treasury

# Exchange-rate provider order, best first (default: fred,frankfurter).
# FX_PROVIDERS=fred,frankfurter

# Tier 1. Earnings and ex-dividend calendars. Finnhub is preferred; yfinance (tier 0, no key) is fallback.
# Free key: https://finnhub.io
# FINNHUB_API_KEY="your-finnhub-key"

# Event provider order, best first (default: finnhub,yfinance).
# EVENT_PROVIDERS=finnhub,yfinance

# --- Local ---------------------------------------------------------------------------------

# Saved runs, snapshots and caches (default: ./data).
# RESEARCH_DATA_DIR="D:/Fieldnote/data"

# Tier 0. Set to 0 to disable the host-built daily XNYS Outlook live log (default: enabled).
# OUTLOOK_LIVE_LOG_ENABLED=1
