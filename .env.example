# Copy this file to .env, then uncomment and fill in only the settings you need.
# .env stays local and must not be committed or shared.
# Tiers: 0 = free, no key; 1 = free with a key; 2 = paid. Anything not set is skipped and shown as
# "not configured" on the Setup & status page, with the variable to set; nothing crashes.

# --- Required ------------------------------------------------------------------------------

# Tier 0. SEC filings, fundamentals and company lookup. SEC requires a name and a real contact email.
# SEC_USER_AGENT="Fieldnote your-email@example.com"

# Tier 2 (OpenRouter pay-per-use; its free models are rate-limited). Choose one provider and a
# model that supports tool calling.
# RESEARCH_MODEL_PROVIDER=openrouter
# RESEARCH_MODEL="provider/model-id"
# OPENROUTER_API_KEY="your-openrouter-key"

# For OpenAI or a trusted compatible provider, use these instead.
# RESEARCH_MODEL_PROVIDER=openai
# RESEARCH_MODEL="your-openai-model"
# OPENAI_API_KEY="your-openai-key"
# RESEARCH_MODEL_PROVIDER=compatible
# OPENAI_BASE_URL="https://your-compatible-provider.example/v1"

# --- Optional upgrades ---------------------------------------------------------------------

# Tier 1. Daily prices with as-traded and adjusted closes; goes before yfinance (tier 0, no key)
# when set. Free key: https://www.tiingo.com (50 requests/hour, 1,000/day).
# TIINGO_API_KEY="your-tiingo-key"

# Price provider order, best first (default: tiingo,yfinance). Unconfigured providers are skipped.
# PRICE_PROVIDERS=tiingo,yfinance

# Tier 1. Rates, inflation and unemployment as published on the cutoff day (ALFRED vintages), and the
# release dates of major US data. Without it, Treasury (tier 0, no key) gives the bill rate and yields only.
# The same key gives H.10 exchange rates for converting foreign filers' figures to US dollars (including TWD);
# without it, Frankfurter (ECB rates, tier 0, no key) converts most currencies but not TWD.
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY="your-fred-key"

# Macro provider order, best first (default: fred,treasury).
# MACRO_PROVIDERS=fred,treasury

# Exchange-rate provider order, best first (default: fred,frankfurter).
# FX_PROVIDERS=fred,frankfurter

# --- Local ---------------------------------------------------------------------------------

# Saved runs, snapshots and caches (default: ./data).
# RESEARCH_DATA_DIR="D:/Fieldnote/data"
