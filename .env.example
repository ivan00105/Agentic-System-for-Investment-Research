# Copy this file to .env, then uncomment and fill in only the settings you need.
# .env stays local and must not be committed or shared.

# SEC financial data: use your real contact email.
# SEC_USER_AGENT="Fieldnote your-email@example.com"

# Optional model analysis: choose one provider and a compatible model.
# RESEARCH_MODEL_PROVIDER=openrouter
# RESEARCH_MODEL="provider/model-id"
# OPENROUTER_API_KEY="your-openrouter-key"

# For OpenAI or a trusted compatible provider, use these instead.
# RESEARCH_MODEL_PROVIDER=openai
# RESEARCH_MODEL="your-openai-model"
# OPENAI_API_KEY="your-openai-key"
# RESEARCH_MODEL_PROVIDER=compatible
# OPENAI_BASE_URL="https://your-compatible-provider.example/v1"

# Optional: choose a different local data directory.
# RESEARCH_DATA_DIR="D:/Fieldnote/data"
